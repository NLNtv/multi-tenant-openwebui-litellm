graph TD
    subgraph Internet ["Public Internet"]
        ClientUser["Corporate Client Browser"]
        UpstreamOpenAI["OpenAI API (api.openai.com:443)"]
        UpstreamAnthropic["Anthropic API (api.anthropic.com:443)"]
        UpstreamAzure["Azure OpenAI / AWS Bedrock"]
        CorporateLDAP_A["Acme Active Directory (ldaps.acme.com:636)"]
        CorporateLDAP_B["Globex Active Directory (ldaps.globex.com:636)"]
    end

    subgraph K8sCluster ["Kubernetes Cluster Boundary"]
        subgraph IngressNS ["Namespace: ingress-nginx"]
            IngressCtrl["Ingress-Nginx Controller (LoadBalancer :443)"]
        end

        subgraph TenantA ["Namespace: tenant-acme (Isolated Perimeter)"]
            PodA["OpenWebUI Pod (Acme)<br/>RunAsUser: 1000"]
            PVCA[("Dedicated PVC<br/>(webui.db / docs)")]
            LiteLLMA["Dedicated LiteLLM Proxy<br/>ClusterIP: litellm:4000<br/>(Acme BYOK / Scoped Keys)"]
            PodA --- PVCA
            PodA -->|Intra-Namespace HTTP :4000| LiteLLMA
        end

        subgraph TenantB ["Namespace: tenant-globex (Isolated Perimeter)"]
            PodB["OpenWebUI Pod (Globex)<br/>RunAsUser: 1000"]
            PVCB[("Dedicated PVC<br/>(webui.db / docs)")]
            LiteLLMB["Dedicated LiteLLM Proxy<br/>ClusterIP: litellm:4000<br/>(Globex BYOK / Scoped Keys)"]
            PodB --- PVCB
            PodB -->|Intra-Namespace HTTP :4000| LiteLLMB
        end

        subgraph KubeSystem ["Namespace: kube-system"]
            CoreDNS["CoreDNS (53 UDP/TCP)"]
        end
    end

    %% Ingress Flow
    ClientUser -->|HTTPS 443| IngressCtrl
    IngressCtrl -->|HTTP 8080 acme.ai.saas.com| PodA
    IngressCtrl -->|HTTP 8080 globex.ai.saas.com| PodB

    %% Tenant Internal & External Egress Flows
    PodA -->|Port 636 LDAPS TLS| CorporateLDAP_A
    PodB -->|Port 636 LDAPS TLS| CorporateLDAP_B
    PodA -->|Port 53 DNS| CoreDNS
    PodB -->|Port 53 DNS| CoreDNS
    LiteLLMA -->|Port 53 DNS| CoreDNS
    LiteLLMB -->|Port 53 DNS| CoreDNS

    %% Dedicated Proxy Egress to Upstream LLMs (Isolated per tenant)
    LiteLLMA -->|HTTPS 443 (Acme Keys)| UpstreamOpenAI
    LiteLLMA -->|HTTPS 443 (Acme Keys)| UpstreamAnthropic
    LiteLLMB -->|HTTPS 443 (Globex Keys)| UpstreamAzure

    %% Blocked Traffic Indicators (Zero Trust)
    PodA -.->|BLOCKED: Cross-Tenant Denied| PodB
    LiteLLMA -.->|BLOCKED: Cross-Tenant Denied| LiteLLMB
    PodA -.->|BLOCKED: Direct Internet Denied| UpstreamOpenAI
    PodA -.->|BLOCKED: Metadata 169.254.169.254 Denied| Internet
    LiteLLMA -.->|BLOCKED: Metadata 169.254.169.254 Denied| Internet

    classDef allowed stroke:#2ecc71,stroke-width:2px,fill:#e8f8f5;
    classDef blocked stroke:#e74c3c,stroke-width:2px,stroke-dasharray: 5 5,fill:#fadbd8;
    classDef tenant stroke:#9b59b6,stroke-width:2px,fill:#f5eef8;
    classDef proxy stroke:#3498db,stroke-width:2px,fill:#ebf5fb;

    class PodA,PodB tenant;
    class LiteLLMA,LiteLLMB proxy;
